SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-service-role-or-server-key"

# Admin access for this specific invite.
ADMIN_PASSWORD="change-me"
ADMIN_TOKEN="change-me-long-random-token"

# Supabase table used by this invite.
# Use a different table name for every invite, for example:
# partecipanti_sabrina_2026
INVITE_TABLE="partecipanti"

# Photo upload to Google Drive.
# Share the Drive folder with the service account email as Editor.
GOOGLE_DRIVE_PHOTOS_FOLDER_ID="drive-folder-id"
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com","client_id":"..."}'
