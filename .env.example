SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-service-role-or-server-key"

# Admin access for this specific invite.
ADMIN_PASSWORD="change-me"
ADMIN_TOKEN="change-me-long-random-token"
CRON_SECRET="change-me-long-random-token"

# Supabase table used by this invite.
# Use a different table name for every invite, for example:
# partecipanti_sabrina_2026
INVITE_TABLE="partecipanti"

# Photo upload to Google Drive through Google Apps Script.
PHOTO_UPLOAD_WEBHOOK_URL="https://script.google.com/macros/s/.../exec"
PHOTO_UPLOAD_SECRET="same-secret-used-in-apps-script"
